body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #ff9a9e, #fad0c4);
    text-align: center;
    margin: 0;
    padding: 0;
}

.navbar {
    background-color: #ff69b4;
    padding: 15px;
}

.navbar a {
    color: white;
    text-decoration: none;
    margin: 10px;
    font-weight: bold;
}

header {
    margin-top: 20px;
}

footer {
    margin-top: 20px;
    padding: 10px;
    background: #ff69b4;
    color: white;
}
/* Styl dla zakładki Konto */
.konto {
    background: linear-gradient(135deg, #89f7fe, #66a6ff);
    text-align: center;
    padding: 20px;
}

.formularz {
    background: white;
    padding: 20px;
    margin: 20px auto;
    width: 300px;
    border-radius: 10px;
    box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
}

input {
    width: 90%;
    padding: 10px;
    margin: 10px 0;
    border: 1px solid #ccc;
    border-radius: 5px;
}

button {
    background: #66a6ff;
    color: white;
    padding: 10px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
}

button:hover {
    background: #5599ff;
}
