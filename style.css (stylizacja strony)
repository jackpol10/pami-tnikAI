/* Import nowoczesnej czcionki */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap');

/* Styl ogólny */
body {
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg, #ff9a9e, #fad0c4);
    text-align: center;
    margin: 0;
    padding: 0;
    color: #333;
}

/* Nawigacja */
.navbar {
    background-color: #ff69b4;
    padding: 15px;
    border-radius: 10px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
    display: flex;
    justify-content: center;
    gap: 20px;
}

.navbar a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    transition: all 0.3s;
    padding: 10px 15px;
    border-radius: 5px;
}

.navbar a:hover {
    background-color: #ff1493;
    transform: scale(1.1);
}

/* Kontener strony */
.container {
    max-width: 600px;
    margin: 50px auto;
    padding: 20px;
    background: white;
    border-radius: 15px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
}

/* Formularz */
.formularz {
    background: #fff0f5;
    padding: 20px;
    border-radius: 10px;
    margin: 20px auto;
    width: 80%;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
}

.formularz h2 {
    color: #ff1493;
    font-size: 1.5em;
}

.formularz input {
    width: 90%;
    padding: 10px;
    margin: 10px 0;
    border: 1px solid #ff69b4;
    border-radius: 5px;
    font-size: 1em;
}

.formularz button {
    background: #ff69b4;
    color: white;
    padding: 10px 20px;
    border: none;
    font-size: 1em;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.3s;
}

.formularz button:hover {
    background: #ff1493;
    transform: scale(1.1);
}

/* Stopka */
footer {
    margin-top: 40px;
    padding: 10px;
    background: #ff69b4;
    color: white;
    font-weight: bold;
    text-align: center;
}
