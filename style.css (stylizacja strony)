body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #ff9a9e, #fad0c4);
    text-align: center;
    margin: 0;
    padding: 0;
}

.navbar {
    background-color: #ff69b4;
    padding: 15px;
}

.navbar a {
    color: white;
    text-decoration: none;
    margin: 10px;
    font-weight: bold;
}

header {
    margin-top: 20px;
}

footer {
    margin-top: 20px;
    padding: 10px;
    background: #ff69b4;
    color: white;
}

